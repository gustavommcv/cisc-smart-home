<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- To reach the board. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To keep watching the board with the screen off, as a foreground service of the connected-device kind. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Android (13 and later) shows no notification, the warning of a leak included, without this. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android asks for one of a few permissions, this among them, of a connected-device service; binding to the board's network will use it. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <application
        android:name=".CiscApplication"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CISCCasa">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.HomeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>

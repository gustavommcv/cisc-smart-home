	)
	(text "O LCD fica no 5 V e o ESP32 no 3,3 V;\no conversor passa o SDA e o SCL entre os dois."
		(exclude_from_sim no)
		(at 193.04 147.955 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2e44e144-c426-483a-aa51-1174d83e65d7")
	)
	(text "5V: não ligar\n(ESP32 pela USB)"
